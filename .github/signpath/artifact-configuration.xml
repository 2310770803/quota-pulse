<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="installer/Quota-Pulse-Setup-${version}.exe"
      product-name="Quota Pulse"
      product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file
      path="portable/Quota-Pulse-${version}.exe"
      product-name="Quota Pulse"
      product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
